    "from pathlib import Path\n",
    "import sys\n",
    "\n",
    "repo_root = next(\n",
    "    path\n",
    "    for path in (Path.cwd(), *Path.cwd().parents)\n",
    "    if (path / \"src\" / \"__init__.py\").is_file()\n",
    ")\n",
    "sys.path.insert(0, str(repo_root)) if str(repo_root) not in sys.path else None\n",
    "\n",
    "import src"
   ]
